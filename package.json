{
  "name": "@jordyvanvorselen/pi-bare-worktrees",
  "version": "0.1.1",
  "description": "Git worktrees for --bare checkouts in pi: one worktree per task, shared env links, protected branches, and a worktree tool the agent uses itself.",
  "type": "module",
  "license": "MIT",
  "author": "Jordy van Vorselen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordyvanvorselen/pi-bare-worktrees.git"
  },
  "homepage": "https://github.com/jordyvanvorselen/pi-bare-worktrees#readme",
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "git",
    "worktree",
    "bare",
    "extension"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "lint": "eslint . && npm run format",
    "lint:fix": "eslint . --fix && npm run format:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write . --log-level warn"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.87.0",
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "@earendil-works/pi-tui": ">=0.87.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "semver": "^7.8.5",
    "typebox": "1.3.27",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
